# اتصال پایگاه داده (نشانی pooled از Neon/Supabase یا هر Postgres دیگری)
DATABASE_URL=postgres://user:password@host:5432/dbname

# حساب مدیریت کنسول
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=یک-رشتهٔ-تصادفی-و-بلند-جایگزین-کنید

# نشانی عمومی سایت (اختیاری): پایهٔ لینک‌هایی که در پیامک آموت می‌رود.
# خالی بماند، از هدر درخواست (x-forwarded-host) ساخته می‌شود.
NEXT_PUBLIC_SITE_URL=

# اختیاری: نمکِ هشِ خوانندهٔ ناشناس (نبودش به یک ثابتِ درون‌کد برمی‌گردد).
# تغییرش باعث می‌شود همهٔ خواننده‌ها تازه به نظر برسند.
ENGAGEMENT_SALT=یک-رشتهٔ-تصادفی-و-بلند-جایگزین-کنید

# تقویم گوگل (اختیاری — بدون این‌ها برنامه‌ریز آفلاین کار می‌کند)
# راهنمای ساخت پروژه و OAuth client در README آمده است.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback

# توکن کرون برای دریافت دوره‌ای تغییرات تقویم (اختیاری)
# GET /api/google/sync با هدر Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ذخیره‌سازی رسانه روی S3 آروان (اختیاری — بدون این‌ها درج با لینک کار می‌کند)
# باکت باید Public Read باشد یا از MEDIA_PREVIEW_HOSTS استفاده کنید.
ARVAN_S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
ARVAN_S3_REGION=ir-thr-at1
ARVAN_S3_BUCKET=
ARVAN_S3_ACCESS_KEY_ID=
ARVAN_S3_SECRET_ACCESS_KEY=
# دامنهٔ عمومی فایل‌ها؛ اگر خالی باشد از endpoint + bucket ساخته می‌شود.
ARVAN_S3_PUBLIC_BASE_URL=
ARVAN_S3_FORCE_PATH_STYLE=true

# میزبان‌های مجاز برای پیش‌نمایش/download رسانه (با کاما جدا کنید).
# میزبان عمومی S3 به‌صورت خودکار مجاز است.
MEDIA_PREVIEW_HOSTS=

# نسخهٔ Pyodide برای دفترچهٔ پایتون (سمت مرورگر).
NEXT_PUBLIC_PYODIDE_INDEX_URL=https://cdn.jsdelivr.net/pyodide/v0.29.5/full/

