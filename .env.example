# ============================================================================
# Studio console — copy this file to `.env.local` and fill in the values.
# The same keys live in Vercel → Project → Settings → Environment Variables.
# ============================================================================

# Pooled Postgres URL (Neon: host contains `-pooler`; Supabase: port 6543).
# Tables and the demo content are created with `npm run db:setup`.
DATABASE_URL=postgres://user:password@host-pooler.example.com/studio?sslmode=require

# Single admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# At least 32 random characters. Rotating it signs every session out.
ADMIN_SESSION_SECRET=
